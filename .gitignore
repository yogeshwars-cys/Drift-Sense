# Python
__pycache__/
*.py[cod]
.venv/

# NOTE: model weights are deliberately NOT ignored. The problem statement
# requires "DL Model Weights ... included in a downloadable format ... loaded
# automatically by your inference script", so reranker.pt must be committed.

# Generated datasets -- reproducible from dataset_generator.py with the seeds
# recorded in README.md, so they are not checked in.
dataset*/images/
dataset*/ground_truth.json

# Per-run result dumps
*_results.json
results/

# Scratch datasets written by probes/robustness_sweep.py
_sweep/

# Deck build tree. deck/build_deck.js, package.json and the built .pptx ARE
# checked in -- the deck is a required submission artefact.
node_modules/

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
